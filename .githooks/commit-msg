#!/bin/sh
#
# Rejects commit messages that are not Conventional Commits.
#
# release-please reads these to decide the next version and to write the
# changelog, so a message that does not parse is a release that does not happen.
#
# Deliberately dependency-free: this repository publishes to npm, and every
# package added here is one more thing to trust. Install it with
# `npm run hooks:install`.

message_file="$1"
# Ignore comment lines, which is what git strips before committing anyway.
header="$(grep -v '^#' "$message_file" | sed '/^[[:space:]]*$/d' | head -n 1)"

if [ -z "$header" ]; then
  echo "commit-msg: the commit message is empty." >&2
  exit 1
fi

# Merges, reverts and fixups are generated by git; leave them alone.
case "$header" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

# type(optional scope)optional !: subject
if ! printf '%s' "$header" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: .+"; then
  cat >&2 <<EOF
commit-msg: this message is not a Conventional Commit.

  $header

Expected:  <type>[optional scope][!]: <subject>

  feat: add multi-layer archives
  fix(read): attach holes to the containing ring
  docs: explain the nested layout
  feat!: drop the trimStrings option

Types:     $(printf '%s' "$types" | tr '|' ' ')
A "!" or a "BREAKING CHANGE:" footer marks a breaking change.

release-please uses these to pick the next version and write the changelog.
EOF
  exit 1
fi

# 72 is the conventional soft limit; 100 is where GitHub starts truncating.
length=$(printf '%s' "$header" | wc -c | tr -d ' ')
if [ "$length" -gt 100 ]; then
  echo "commit-msg: the subject line is $length characters; keep it under 100." >&2
  exit 1
fi

exit 0
